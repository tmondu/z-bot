# ===================================================
# CẤU HÌNH BOT ZALO TRỢ GIẢNG TIẾNG NHẬT PTHAMSS
# ===================================================

# 1. Google Gemini AI API Key
# Đăng ký và lấy key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini sử dụng (gemini-3.6-flash hoặc gemini-1.5-flash)
GEMINI_MODEL=gemini-3.6-flash

# 2. Cấu hình Bot
# Tên đại diện của bot trong lời chào và hướng dẫn
BOT_NAME=Trợ Giảng Tiếng Nhật PThamSS

# Tiền tố lệnh để gọi bot trong nhóm (cách nhau bằng dấu phẩy)
BOT_PREFIXES=/hoi,/kanji,/dich,/nguphap,/help

# Tự động trả lời tin nhắn riêng 1-1 không cần tag (true/false)
REPLY_DIRECT_MESSAGES=true

# 3. Cơ chế Chống Ban & Spam (Anti-Ban & Safety)
# Thời gian chờ giữa 2 lần gọi bot của 1 học viên (mili-giây: 5000 = 5 giây)
COOLDOWN_MS=5000

# Bật hiển thị trạng thái "đang soạn tin..." trước khi gửi (true/false)
SIMULATE_TYPING=true

# Tốc độ gõ phím mô phỏng theo độ dài văn bản (mili-giây / ký tự, ví dụ: 20ms/ký tự)
# Câu trả lời dài 150 ký tự -> ~3000ms gõ phím
TYPING_SPEED_MS_PER_CHAR=20

# Giới hạn độ trễ gõ phím (mili-giây): tối thiểu (1.5s) và tối đa (8s)
TYPING_DELAY_MIN_MS=1500
TYPING_DELAY_MAX_MS=8000

